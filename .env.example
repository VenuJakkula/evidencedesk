# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
EVIDENCEDESK_API_KEY=replace-with-generated-secret
EVIDENCEDESK_TENANT=demo
EVIDENCEDESK_DB=evidencedesk.db
# Local mode uses one configured tenant; verified enterprise access is described in docs/ACCESS.md.
# Optional key rotation API: enable only with a loopback-bound, single-worker server.
EVIDENCEDESK_ALLOW_LOCAL_KEY_RECOVERY=0
# Optional automatic frontend connection; loopback development only.
EVIDENCEDESK_ALLOW_LOCAL_FRONTEND=0

# T07: local synthetic mode or verified OIDC API access tokens
EVIDENCEDESK_AUTH_MODE=local
EVIDENCEDESK_DEPLOYMENT=local
# Configure these server-side for oidc mode; no tokens/client secrets in this file.
# EVIDENCEDESK_OIDC_ISSUER=https://issuer.example/
# EVIDENCEDESK_OIDC_AUDIENCE=evidencedesk-api
# EVIDENCEDESK_OIDC_JWKS_URL=https://issuer.example/keys
# EVIDENCEDESK_OIDC_JWKS_FILE=/trusted/public-jwks.json

# T09 opt-in retrieval; authoritative workflow/evidence storage remains SQLite.
EVIDENCEDESK_DRAFT_ENGINE=baseline
EVIDENCEDESK_RETRIEVAL_BACKEND=postgres
EVIDENCEDESK_MODEL_PROVIDER=fixture
# Configure secrets through server environment; never put them in VITE_*.
# EVIDENCEDESK_RETRIEVAL_DSN=postgresql://user:password@127.0.0.1:5433/evidencedesk_retrieval
# gateway uses a deployment-owned HTTPS service with /embed and /draft contracts.
# EVIDENCEDESK_PROVIDER_URL=https://trusted-gateway.example/api
# EVIDENCEDESK_PROVIDER_KEY=server-side-secret
# EVIDENCEDESK_EMBEDDING_MODEL=full-versioned-64-dimensional-model-id
# EVIDENCEDESK_DRAFT_MODEL=full-versioned-model-id

# T10 live workflows are disabled unless explicitly opted in with per-job budgets.
EVIDENCEDESK_ALLOW_LIVE_WORKFLOWS=0
# Positive contracted upper price caps are required for the gateway workflow adapter.
# EVIDENCEDESK_WORKFLOW_EMBED_INPUT_USD_PER_1K=<contracted-positive-cap>
# EVIDENCEDESK_WORKFLOW_DRAFT_INPUT_USD_PER_1K=<contracted-positive-cap>
# EVIDENCEDESK_WORKFLOW_DRAFT_OUTPUT_USD_PER_1K=<contracted-positive-cap>
# Supply EVIDENCEDESK_WORKFLOW_TOKEN only via an operator secret environment, for the one-step CLI.

# T12 optional A2A learning services; requires configured OIDC and shared authoritative DB.
# One expert process per DB; loopback HTTP is allowed only in local deployment mode.
# EVIDENCEDESK_A2A_PORT=8011
# EVIDENCEDESK_A2A_PUBLIC_URL=http://127.0.0.1:8011
# EVIDENCEDESK_A2A_EXPERT_URL=http://127.0.0.1:8011
# EVIDENCEDESK_A2A_QUESTIONNAIRE_PORT=8012

# T13 optional bounded process-local retrieval cache; authorization always rechecked.
EVIDENCEDESK_CACHE=0
# Protected operator path; rotate/retain locally according to your policy.
# EVIDENCEDESK_TRACE_FILE=/data/operations.jsonl
# Remote trace export is opt-in. Only allowlisted numeric/status metrics and random IDs leave the process.
# EVIDENCEDESK_TRACE_EXPORT=langsmith
# EVIDENCEDESK_TRACE_ENDPOINT=https://your-approved-langsmith-endpoint
# EVIDENCEDESK_TRACE_KEY=server-side-secret
